@model HospitalManagement.MVC.Dtos.Responses.PatientResponse
@using HospitalManagement.MVC.Auth

@{
    ViewData["Title"] = "Patient Details";
}

<h1>Patient Details</h1>

<dl class="row">
    <dt class="col-sm-2">First Name</dt>
    <dd class="col-sm-10">@Model.FirstName</dd>

    <dt class="col-sm-2">Last Name</dt>
    <dd class="col-sm-10">@Model.LastName</dd>

    <dt class="col-sm-2">Date of Birth</dt>
    <dd class="col-sm-10">@Model.DateOfBirth.ToString("d")</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Phone Number</dt>
    <dd class="col-sm-10">@Model.PhoneNumber</dd>

    <dt class="col-sm-2">Created At</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("g")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
@if (User.IsInRole(AppRoles.Administrator))
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this patient?');">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
}
<a asp-action="Index" class="btn btn-secondary">Back to List</a>