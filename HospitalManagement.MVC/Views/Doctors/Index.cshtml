@model HospitalManagement.MVC.Models.Doctors.DoctorIndexViewModel
@using HospitalManagement.MVC.Auth

@{
    ViewData["Title"] = "Doctors";

    Func<string, string> sortUrl = column =>
    {
        var desc = Model.SortBy == column && !Model.SortDescending;
        return Url.Action("Index", new
        {
            search = Model.Search,
            sortBy = column,
            sortDescending = desc,
            pageNumber = 1,
            pageSize = Model.Page.PageSize
        })!;
    };
}

<h1>Doctors</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Search</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th><a href="@sortUrl("firstName")">First Name</a></th>
            <th><a href="@sortUrl("lastName")">Last Name</a></th>
            <th><a href="@sortUrl("specialization")">Specialization</a></th>
            <th><a href="@sortUrl("email")">Email</a></th>
            <th>Phone Number</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model.Page.Items)
        {
            <tr>
                <td>@doctor.FirstName</td>
                <td>@doctor.LastName</td>
                <td>@doctor.Specialization</td>
                <td>@doctor.Email</td>
                <td>@doctor.PhoneNumber</td>
                <td>
                    <a asp-action="Details" asp-route-id="@doctor.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@doctor.Id">Edit</a>
                    @if (User.IsInRole(AppRoles.Administrator))
                    {
                        <text> | </text>
                        <form asp-action="Delete" asp-route-id="@doctor.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this doctor?');">
                            <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @if (Model.Page.HasPreviousPage)
    {
        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" asp-route-pageNumber="@(Model.Page.PageNumber - 1)" asp-route-pageSize="@Model.Page.PageSize">Previous</a>
    }
    <span>Page @Model.Page.PageNumber of @Model.Page.TotalPages</span>
    @if (Model.Page.HasNextPage)
    {
        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" asp-route-pageNumber="@(Model.Page.PageNumber + 1)" asp-route-pageSize="@Model.Page.PageSize">Next</a>
    }
</div>

@await Html.PartialAsync("_ApiErrorModal")