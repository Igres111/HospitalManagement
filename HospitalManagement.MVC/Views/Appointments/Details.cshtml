@model HospitalManagement.MVC.Dtos.Responses.AppointmentResponse
@using HospitalManagement.MVC.Dtos

@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Appointment Details</h1>

<dl class="row">
    <dt class="col-sm-2">Doctor</dt>
    <dd class="col-sm-10">@Model.DoctorName @Model.DoctorLastName</dd>

    <dt class="col-sm-2">Patient</dt>
    <dd class="col-sm-10">@Model.PatientName @Model.PatientLastName</dd>

    <dt class="col-sm-2">Appointment Date</dt>
    <dd class="col-sm-10">@Model.AppointmentDate.ToString("g")</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Created At</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("g")</dd>
</dl>

@if (Model.Status != AppointmentStatus.Completed && Model.Status != AppointmentStatus.Cancelled)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
}
@if (Model.Status != AppointmentStatus.Completed)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this appointment?');">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
}
<a asp-action="Index" class="btn btn-secondary">Back to List</a>